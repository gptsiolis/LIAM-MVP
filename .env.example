# =============================================================================
# LIAM MVP — Environment Variables
# =============================================================================
# Copy this file to .env (or .env.local) and fill in real values.
# NEVER commit .env or .env.local to git.
# =============================================================================

# --- Database ---
# Local development: SQLite via better-sqlite3
DATABASE_URL="file:./dev.db"

# Production (Turso — hosted LibSQL, SQLite-compatible):
# DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# --- Auth ---
# JWT secret for session cookies. Use a long random string in production.
# Generate one with: openssl rand -base64 32
JWT_SECRET="liam-mvp-dev-secret-change-in-production"

# --- Future: Payment (not yet integrated) ---
